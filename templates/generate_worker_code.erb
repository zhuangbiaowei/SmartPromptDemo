```Ruby
require "numo/narray"

SmartPrompt.define_worker :get_embedding do
  use "siliconflow"
  model "BAAI/bge-large-zh-v1.5"
  prompt params[:text]
  result = embeddings
  x = Numo::NArray.cast(result[0..params[:length] - 1])
  norm = Math.sqrt((x * x).sum)
  (x / norm).to_a
end
```

